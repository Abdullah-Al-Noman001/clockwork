{
  "name": "clockwork",
  "version": "1.1.0",
  "description": "Clockwork focus timer with tasks, ambience, and playlists",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.clockwork.focus",
    "productName": "Clockwork",
    "files": ["index.html", "style.css", "script.js", "media.js", "config.js", "main.js", "music/**/*", "sounds/**/*", "fonts/**/*", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "icon": "build/icon.png", "category": "Utility" }
  }
}
